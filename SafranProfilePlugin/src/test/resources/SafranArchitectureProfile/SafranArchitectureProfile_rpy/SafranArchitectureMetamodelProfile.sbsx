			<RHP-ID>GUID a7b7dc15-a698-4e7f-9ea2-16c1f2b6e6e5</RHP-ID>
			<NAME>ajouter un conteneur fonctionnel dans B</NAME>
			<TYPE>Comment</TYPE>
			<TYPE-ID>GUID_38557fcc-40d3-4174-b445-f37f92a6ae41_1620664094</TYPE-ID>
			<DISPLAY-TYPE>Comment</DISPLAY-TYPE>
			<DISPLAY-GROUP>Comments</DISPLAY-GROUP>
			<BROWSER-ICON>Comment~ALL~BrowserIcon</BROWSER-ICON>
			<GROUP-ICON>Comment~ALL~GroupIcon</GROUP-ICON>
			<IS-TOP-LEVEL>false</IS-TOP-LEVEL>
			<MODIFIED-TIME-UTC>2025/5/12 13:43:34</MODIFIED-TIME-UTC>
			<VIEW-PARENTS></VIEW-PARENTS>
			<VIEW-CHILDREN></VIEW-CHILDREN>
			<AGGREGATES></AGGREGATES>
			<REFERENCES></REFERENCES>
			<DESCRIPTION>
				<PLAIN-TEXT>il faut un objet &quot;Functional system&quot; qui contient les fonctions dans le Functional Analysis Package, %E9quivalent d'un syst%E8me qui ne se d%E9compose pas en sous syst%E8mes mais qui contient la d%E9composition fonctionnelle en vis %E0 vis de la d%E9composuition logique pour pouvoir allouer les fonctions feuilles aux syst%E8mes logiques via le lien/matrice d'allocation syst%E8me logique =&gt; function</PLAIN-TEXT>
			</DESCRIPTION>
		</ELEMENT>
