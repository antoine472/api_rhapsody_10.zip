				<_textRTF type="a">{\rtf1\ansi\ansicpg1252\deff0\deflang1036{\fonttbl{\f0\froman\fprq10\fcharset0 Tahoma;}}%0D
\viewkind4\uc1\pard\f0\fs20 needed to allow the creation of functions from an architecture diagram contained in an operational system : Rhapsody creates the function directly in the domain package, then it is moved in the operational system when using the &quot;nest function&quot; feature\par%0D
}%0D
</_textRTF>
			</IDescription>
			</m_pNoteText>
