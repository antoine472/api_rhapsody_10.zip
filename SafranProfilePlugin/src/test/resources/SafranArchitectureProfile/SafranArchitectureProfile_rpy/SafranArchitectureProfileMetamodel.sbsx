			<m_name type="p">
				<CGIText type="e">
					<m_str type="a">un logical analysis  package contient les events cr%E9%E9s lors de la d%E9finition des triggers sur les transitions de mode dans les syst%E8mes logiques, il y a aussi une r%E9ception cr%E9e dans le logical system</m_str>
					<m_style type="a">Arial; 10 0 0 0 1 </m_style>
