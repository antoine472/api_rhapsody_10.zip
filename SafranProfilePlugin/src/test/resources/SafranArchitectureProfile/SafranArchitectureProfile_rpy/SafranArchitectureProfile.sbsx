			<_rmmServerID type="a">1350268_CmvNERkXEemjcZ7iaG_c3w</_rmmServerID>
			<_name type="a">LogicalArchitectureDiagram</_name>
			<_modifiedTimeWeak type="a">10.1.2026::7:57:16</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">A logical architecture diagram represents the logical flows exchanged between logical systems. It can also display the functions owned by the logical systems and the functional flows exchanged between the functions. This is a static data flow diagram. The user can create new ports on decomposed function boundaries and sub-functions and create associated functional flows. The ports can be nested. The user can create new ports on logical systems and functions and create associated logical or functional flows. The ports can be nested.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">3.6.2026::10:51:54</_modifiedTime>
			<_m2Classes type="c">
				<IRPYRawContainer type="e">
					<value>StructureDiagram</value>
				</IRPYRawContainer>
			</_m2Classes>
			<_newTerm type="a">1</_newTerm>
		</IStereotype>
