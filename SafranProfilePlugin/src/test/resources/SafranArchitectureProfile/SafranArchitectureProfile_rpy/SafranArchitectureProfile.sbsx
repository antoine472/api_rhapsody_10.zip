&lt;IMPLEMENTATION&gt;
	&lt;CLASSPATH&gt;
	&lt;/CLASSPATH&gt;
	&lt;IMPORTS&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.*&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPModelElement&lt;/IMPORT&gt;
