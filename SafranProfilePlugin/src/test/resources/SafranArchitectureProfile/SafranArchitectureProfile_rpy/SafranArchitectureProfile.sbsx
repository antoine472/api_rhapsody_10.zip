													<_Value type="a">&lt;COLUMN id=&quot;3&quot;&gt;
&lt;IMPLEMENTATION&gt;
	&lt;CLASSPATH&gt;
	&lt;/CLASSPATH&gt;
	&lt;IMPORTS&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.*&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPModelElement&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPTableView&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.*&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.ArrayList&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPStereotype&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPClass&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPDiagram&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPApplication&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.List&lt;/IMPORT&gt;
	&lt;/IMPORTS&gt;
	&lt;USER-DEFINED-METHOD isUserDefinedMethod=&quot;FALSE&quot;&gt;&lt;/USER-DEFINED-METHOD&gt;
	&lt;ALLOW-SELECTOR&gt;FALSE&lt;/ALLOW-SELECTOR&gt;
	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;List of model elements&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;ArrayList&amp;lt;IRPModelElement&amp;gt; Use_CaseDiagramList = new ArrayList&amp;lt;IRPModelElement&amp;gt;();
IRPStereotype currentIRPStereotype = null;
if(cellElement instanceof IRPClass){
	IRPClass currentIRPOperationalFunction = (IRPClass) cellElement;
	for(Object o : currentIRPOperationalFunction.getReferences().toList()){
		if(o instanceof IRPDiagram){
			IRPDiagram currentIRPDiagram = (IRPDiagram) o;
			currentIRPStereotype = currentIRPDiagram.getNewTermStereotype();
			if (currentIRPStereotype != null) {
				if ((currentIRPStereotype.getName()).compareTo(&amp;quot;Use_CaseDiagram&amp;quot;)==0){
					Use_CaseDiagramList.add(currentIRPDiagram);
				}
			}
		}
	}
	return Use_CaseDiagramList;
}
else{
	return null;
}
&lt;/CODE&gt;
	&lt;/GETTER&gt;
	&lt;SETTER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/SETTER&gt;
	&lt;PICKER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/PICKER&gt;
&lt;/IMPLEMENTATION&gt;
&lt;/COLUMN&gt;
</_Value>
													<_Type type="a">MultiLine</_Type>
