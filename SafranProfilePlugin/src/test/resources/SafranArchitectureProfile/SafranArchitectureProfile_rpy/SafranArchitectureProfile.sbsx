	&lt;GETTER&gt;
		&lt;CODE&gt;if(cellElement instanceof IRPSysMLPort){
	IRPSysMLPort currentIRPSysMLPort = (IRPSysMLPort) cellElement;	
	IRPClassifier currentIRPClassifier = currentIRPSysMLPort.getType();
	return currentIRPClassifier;
}	
else{
