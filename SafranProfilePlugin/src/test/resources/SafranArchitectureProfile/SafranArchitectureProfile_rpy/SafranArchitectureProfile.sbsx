													<_Name type="a">UserDefinedImplementationXML</_Name>
													<_Value type="a">&lt;COLUMN id=&quot;0&quot;&gt;
&lt;IMPLEMENTATION&gt;
	&lt;CLASSPATH&gt;
	&lt;/CLASSPATH&gt;
	&lt;IMPORTS&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPApplication&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPModelElement&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPTableView&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.List&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.*&lt;/IMPORT&gt;
	&lt;/IMPORTS&gt;
	&lt;USER-DEFINED-METHOD isUserDefinedMethod=&quot;FALSE&quot;&gt;&lt;/USER-DEFINED-METHOD&gt;
	&lt;ALLOW-SELECTOR&gt;FALSE&lt;/ALLOW-SELECTOR&gt;
	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;Model element&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;IRPStereotype currentIRPDiagramOwnerStereotype = null;
IRPStereotype currentLifecycleStereotype = null;
IRPStructureDiagram currentIRPStructureDiagram = null;
IRPModelElement currentDiagramOwner = null;
IRPModelElement currentLifecycle = null;
if(cellElement instanceof IRPStructureDiagram){
	currentIRPStructureDiagram = (IRPStructureDiagram) cellElement;
	currentDiagramOwner = currentIRPStructureDiagram.getOwner();
	currentIRPDiagramOwnerStereotype = currentDiagramOwner.getNewTermStereotype();
	if (currentIRPDiagramOwnerStereotype != null) {
		if ((currentIRPDiagramOwnerStereotype.getName()).compareTo(&amp;quot;Context&amp;quot;)==0){
			currentLifecycle = currentDiagramOwner.getOwner();
			if(currentLifecycle!=null){
				currentLifecycleStereotype = currentLifecycle.getNewTermStereotype();
				if(currentLifecycleStereotype!=null){
					if ((currentLifecycleStereotype.getName()).compareTo(&amp;quot;LifecyclePhase&amp;quot;)==0){
						return currentLifecycle;
					}
					else{
						return null;
					}
				}
				else{
					return null;
				}
			}
			else{
				return null;
			}	
		}
	}
	else{
		return null;
	}
	return null;
}
else{
	return null;
}
&lt;/CODE&gt;
	&lt;/GETTER&gt;
	&lt;SETTER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/SETTER&gt;
	&lt;PICKER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/PICKER&gt;
&lt;/IMPLEMENTATION&gt;
&lt;/COLUMN&gt;
</_Value>
