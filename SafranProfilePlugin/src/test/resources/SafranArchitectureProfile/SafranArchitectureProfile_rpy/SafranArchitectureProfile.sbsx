			<_rmmServerID type="a">1350314_CmvNERkXEemjcZ7iaG_c3w</_rmmServerID>
			<_name type="a">FunctionalBehaviorDiagram</_name>
			<_modifiedTimeWeak type="a">10.1.2026::7:57:16</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">The functional behavior diagram represents a function decomposition into sub-functions, the connections betweens sub-functions and with decomposed function inputs and outputs. This is a static data flow diagram. The user can create new ports on decomposed function boundaries and sub-functions and create associated functional flows. The ports can be nested.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">3.6.2026::10:52:10</_modifiedTime>
			<_m2Classes type="c">
				<IRPYRawContainer type="e">
					<value>StructureDiagram</value>
				</IRPYRawContainer>
			</_m2Classes>
			<_newTerm type="a">1</_newTerm>
		</IStereotype>
