	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;List of model elements&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;ArrayList&amp;lt;IRPModelElement&amp;gt; UseCaseList = new ArrayList&amp;lt;IRPModelElement&amp;gt;();
IRPClassifier currentIRPClassifier = null;
IRPStereotype currentIRPStereotype = null;
if(cellElement instanceof IRPClass){
	IRPClass currentIRPClass = (IRPClass) cellElement;
	for(Object o : currentIRPClass.getRelations().toList()){
		if(o instanceof IRPRelation){
			IRPRelation currentIRPRelation = (IRPRelation) o;
			if((currentIRPRelation.getRelationType()).compareTo(&amp;quot;Association&amp;quot;)==0){				
				currentIRPClassifier = currentIRPRelation.getOtherClass();
				currentIRPStereotype = currentIRPClassifier.getNewTermStereotype();
				if (currentIRPStereotype != null) {
					if ((currentIRPStereotype.getName()).compareTo(&amp;quot;Use_Case&amp;quot;)==0){
						 if(!UseCaseList.contains(currentIRPClassifier)){
	                                                                                 	UseCaseList.add(currentIRPClassifier);
                                                                                         }
					}
				}
			}
		}
	}	
	return UseCaseList;

}
else{
	return null;
}&lt;/CODE&gt;
