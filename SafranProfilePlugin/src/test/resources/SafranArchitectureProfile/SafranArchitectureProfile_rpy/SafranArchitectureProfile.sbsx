IRPPort ToPort  =  null;

if( cellElement instanceof IRPLink ){
	
	IRPLink  currentIRPLink = ( IRPLink ) cellElement;
	
	IRPStereotype currentIRPStereotype = currentIRPLink.getNewTermStereotype();

	if (currentIRPStereotype != null) {
		if ((currentIRPStereotype.getName()).compareTo(&amp;quot;ContinuousLink&amp;quot;)==0){

			if( currentIRPLink.getToSysMLPort() != null  ){
				ToSysmlPort  =  currentIRPLink.getToSysMLPort();
			}
			else{
				ToSysmlPort  =  (( IRPSysMLPort ) currentIRPLink.getToElement());
			}	
	
			for(Object o : ToSysmlPort.getStereotypes().toList()){
				if(o instanceof IRPStereotype){
					IRPStereotype currentIRPStereotype2 = (IRPStereotype) o;

					if( currentIRPStereotype2.getIsNewTerm() == 0 &amp;amp;&amp;amp; currentIRPStereotype != null ){
						StereotypeList.add(currentIRPStereotype2);
					}
				}
			}
		}
		if ((currentIRPStereotype.getName()).compareTo(&amp;quot;DiscreteLink&amp;quot;)==0){

			if( currentIRPLink.getToPort() != null  ){
				ToPort  =  currentIRPLink.getToPort();
			}
			else{
				ToPort  =  (( IRPPort ) currentIRPLink.getToElement());
			}	
	
			for(Object o : ToPort.getStereotypes().toList()){
				if(o instanceof IRPStereotype){
					IRPStereotype currentIRPStereotype2 = (IRPStereotype) o;

					if( currentIRPStereotype2.getIsNewTerm() == 0 &amp;amp;&amp;amp; currentIRPStereotype != null ){
						StereotypeList.add(currentIRPStereotype2);
					}
				}
			}
		}
	}

	return StereotypeList;
	
}else
{
	return null;
