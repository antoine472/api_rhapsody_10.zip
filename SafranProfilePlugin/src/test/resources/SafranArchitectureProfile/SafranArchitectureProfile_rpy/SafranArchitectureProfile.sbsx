		&lt;IMPORT&gt;java.util.List&lt;/IMPORT&gt;
	&lt;/IMPORTS&gt;
	&lt;USER-DEFINED-METHOD isUserDefinedMethod=&quot;FALSE&quot;&gt;&lt;/USER-DEFINED-METHOD&gt;
	&lt;ALLOW-SELECTOR&gt;FALSE&lt;/ALLOW-SELECTOR&gt;
	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;List of model elements&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;ArrayList&amp;lt;IRPModelElement&amp;gt; myDescribingDiagrams = new ArrayList&amp;lt;IRPModelElement&amp;gt;();

if(cellElement instanceof IRPUseCase){
	IRPUseCase currentIRPUseCase = (IRPUseCase) cellElement;
	IRPCollection allSequenceDiagram =  currentIRPUseCase.getNestedElementsByMetaClass(&amp;quot;SequenceDiagram&amp;quot;, 1);

	for(Object o : allSequenceDiagram.toList()){
		if(o instanceof IRPSequenceDiagram){
			IRPSequenceDiagram currentIRPSequenceDiagram = (IRPSequenceDiagram) o;
			if(!myDescribingDiagrams.contains(currentIRPSequenceDiagram)){
				myDescribingDiagrams.add(currentIRPSequenceDiagram);
			}
		}
	}

	return myDescribingDiagrams;

}

else{
	return null;
}
&lt;/CODE&gt;
	&lt;/GETTER&gt;
	&lt;SETTER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/SETTER&gt;
