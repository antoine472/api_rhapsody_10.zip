		&lt;IMPORT&gt;com.telelogic.rhapsody.core.*&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPTableView&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.List&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPModelElement&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.ArrayList&lt;/IMPORT&gt;
	&lt;/IMPORTS&gt;
	&lt;USER-DEFINED-METHOD isUserDefinedMethod=&quot;FALSE&quot;&gt;&lt;/USER-DEFINED-METHOD&gt;
	&lt;ALLOW-SELECTOR&gt;FALSE&lt;/ALLOW-SELECTOR&gt;
	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;List of model elements&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;ArrayList&amp;lt;IRPModelElement&amp;gt; OperationalSystemList = new ArrayList&amp;lt;IRPModelElement&amp;gt;();
IRPClassifier currentIRPClassifier = null;
IRPStereotype currentIRPStereotype = null;
if(cellElement instanceof IRPUseCase){
	IRPUseCase currentIRPUseCase = (IRPUseCase) cellElement;
	for(Object o : currentIRPUseCase.getReferences().toList()){
		if(o instanceof IRPRelation){
			IRPRelation currentIRPRelation = (IRPRelation) o;
			if((currentIRPRelation.getRelationType()).compareTo(&amp;quot;Association&amp;quot;)==0){				
				currentIRPClassifier = currentIRPRelation.getOfClass();
				currentIRPStereotype = currentIRPClassifier.getNewTermStereotype();
				if (currentIRPStereotype != null) {
					if ((currentIRPStereotype.getName()).compareTo(&amp;quot;OperationalSystem&amp;quot;)==0 || (currentIRPStereotype.getName()).compareTo(&amp;quot;Stakeholder&amp;quot;)==0){
							OperationalSystemList.add(currentIRPClassifier);
						
					}
				}
			}
		}
	}
	return OperationalSystemList;
}
else{
	return null;
}&lt;/CODE&gt;
	&lt;/GETTER&gt;
