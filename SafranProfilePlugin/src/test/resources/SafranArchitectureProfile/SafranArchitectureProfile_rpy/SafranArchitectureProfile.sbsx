ArrayList&amp;lt;IRPModelElement&amp;gt; PortList = new ArrayList&amp;lt;IRPModelElement&amp;gt;();
ArrayList&amp;lt;IRPModelElement&amp;gt; ResultList = new ArrayList&amp;lt;IRPModelElement&amp;gt;();
if(cellElement instanceof IRPClass){
	IRPClass currentIRPClass = (IRPClass) cellElement;
	for(Object o : currentIRPClass.getPorts().toList()){
		IRPModelElement currentPort = (IRPModelElement) o;
		ResultList.add(currentPort);
	}
	return ResultList;
}
else{
return null;
