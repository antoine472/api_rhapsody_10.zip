      @SuppressWarnings(&amp;quot;unchecked&amp;quot;)
       List&amp;lt;IRPModelElement&amp;gt; ConveyedList = (List&amp;lt;IRPModelElement&amp;gt;) mycollection.toList();
       return ConveyedList;

}else{
