													<_Value type="a">&lt;COLUMN id=&quot;1&quot;&gt;
&lt;IMPLEMENTATION&gt;
	&lt;CLASSPATH&gt;
	&lt;/CLASSPATH&gt;
	&lt;IMPORTS&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPModelElement&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPTableView&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.List&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.ArrayList&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPArgument&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPType&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPApplication&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPStereotype&lt;/IMPORT&gt;
	&lt;/IMPORTS&gt;
	&lt;USER-DEFINED-METHOD isUserDefinedMethod=&quot;FALSE&quot;&gt;&lt;/USER-DEFINED-METHOD&gt;
	&lt;ALLOW-SELECTOR&gt;FALSE&lt;/ALLOW-SELECTOR&gt;
	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;List of model elements&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;ArrayList&amp;lt;IRPModelElement&amp;gt; ArgumentList = new ArrayList&amp;lt;IRPModelElement&amp;gt;();
if(cellElement instanceof IRPType){
	IRPType currentIRPType = (IRPType) cellElement;
	for(Object o : currentIRPType.getReferences().toList()){
		if(o instanceof IRPArgument){
			IRPArgument currentIRPArgument = (IRPArgument) o;
			IRPModelElement currentOwnerOfArgument = currentIRPArgument.getOwner();
			if (currentOwnerOfArgument != null){	
				IRPStereotype currentIRPStereotype = currentOwnerOfArgument.getNewTermStereotype();
				if (currentIRPStereotype != null) {
					String stereotypeName = currentIRPStereotype.getName();
					if ((stereotypeName.compareTo(&amp;quot;Function_&amp;quot;)==0)){
						ArgumentList.add(currentOwnerOfArgument);
					}
				}
			}
		}
	}
	return ArgumentList;
}
else{
	return null;
}&lt;/CODE&gt;
	&lt;/GETTER&gt;
	&lt;SETTER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/SETTER&gt;
	&lt;PICKER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/PICKER&gt;
&lt;/IMPLEMENTATION&gt;
&lt;/COLUMN&gt;
</_Value>
