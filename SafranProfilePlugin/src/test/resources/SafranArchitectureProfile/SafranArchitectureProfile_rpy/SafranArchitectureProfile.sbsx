	&lt;/CLASSPATH&gt;
	&lt;IMPORTS&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPApplication&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPModelElement&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPTableView&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.List&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.*&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.ArrayList&lt;/IMPORT&gt;
	&lt;/IMPORTS&gt;
	&lt;USER-DEFINED-METHOD isUserDefinedMethod=&quot;FALSE&quot;&gt;&lt;/USER-DEFINED-METHOD&gt;
	&lt;ALLOW-SELECTOR&gt;FALSE&lt;/ALLOW-SELECTOR&gt;
	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;List of model elements&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;ArrayList&amp;lt;IRPModelElement&amp;gt; LifeCyclePhaseList = new ArrayList&amp;lt;IRPModelElement&amp;gt;();
IRPModelElement currentIRPDiagramOwner = null;
if(cellElement instanceof IRPUseCase){
	IRPUseCase currentIRPUseCase = (IRPUseCase) cellElement;
	for(Object o : currentIRPUseCase.getReferences().toList()){
		if(o instanceof IRPDiagram){
			IRPDiagram currentIRPDiagram = (IRPDiagram) o;
			currentIRPDiagramOwner = currentIRPDiagram.getOwner();
			IRPStereotype currentIRPStereotype = currentIRPDiagram.getNewTermStereotype();
			if (currentIRPStereotype != null) {
				if ((currentIRPStereotype.getName()).compareTo(&amp;quot;Use_CaseDiagram&amp;quot;)==0){
				   IRPStereotype ownerIRPStereotype = currentIRPDiagramOwner.getNewTermStereotype();
				   if (ownerIRPStereotype != null) {
					   if ((ownerIRPStereotype.getName()).compareTo(&amp;quot;LifecyclePhase&amp;quot;)==0){
						 if(!LifeCyclePhaseList.contains(currentIRPDiagramOwner)){
								LifeCyclePhaseList.add(currentIRPDiagramOwner);
						 }
					   }
					}
				}
			}
		}
	}
	return LifeCyclePhaseList;
}
else{
return null;
}&lt;/CODE&gt;
	&lt;/GETTER&gt;
	&lt;SETTER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/SETTER&gt;
	&lt;PICKER&gt;
