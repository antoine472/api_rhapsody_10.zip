			<_rmmServerID type="a">1351582_CmvNERkXEemjcZ7iaG_c3w</_rmmServerID>
			<_name type="a">EnvironmentDiagram</_name>
			<_modifiedTimeWeak type="a">10.1.2026::7:57:16</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">The environment diagram is a global context diagram developed at the initial stage of the lifecycle. It illustrates all the interactions of the System of Interest (SoI) with its environment. Flows are specified and refined in the context diagrams of each lifecycle phase. To optimize readability and focus on particular aspects, the user can create multiple environment diagrams at the lifecycle root. The user can drag and drop the required elements, complete relations among theme to display the flows and add annotations in this diagram.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">3.6.2026::10:52:48</_modifiedTime>
			<_m2Classes type="c">
				<IRPYRawContainer type="e">
					<value>StructureDiagram</value>
				</IRPYRawContainer>
			</_m2Classes>
			<_newTerm type="a">1</_newTerm>
		</IStereotype>
