&lt;COLUMN id=&quot;5&quot;&gt;
&lt;IMPLEMENTATION&gt;
	&lt;CLASSPATH&gt;
	&lt;/CLASSPATH&gt;
	&lt;IMPORTS&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.*&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPModelElement&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPTableView&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.*&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPApplication&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.List&lt;/IMPORT&gt;
	&lt;/IMPORTS&gt;
	&lt;USER-DEFINED-METHOD isUserDefinedMethod=&quot;FALSE&quot;&gt;&lt;/USER-DEFINED-METHOD&gt;
	&lt;ALLOW-SELECTOR&gt;FALSE&lt;/ALLOW-SELECTOR&gt;
	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;Model element&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;if (cellElement instanceof IRPFlow) {
    IRPFlow myflow = (IRPFlow) cellElement;
    IRPSysMLPort end1Port = myflow.getEnd1SysMLPort();
    
    if (end1Port != null) {
        IRPClassifier type = end1Port.getType();
        if (type != null) {
            return type;
        } else {
            return null;
        }
    } else {
        return null;
    }
} else {
    return null;
}

&lt;/CODE&gt;
	&lt;/GETTER&gt;
	&lt;SETTER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/SETTER&gt;
	&lt;PICKER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/PICKER&gt;
&lt;/IMPLEMENTATION&gt;
&lt;/COLUMN&gt;
&lt;COLUMN id=&quot;6&quot;&gt;
&lt;IMPLEMENTATION&gt;
	&lt;CLASSPATH&gt;
	&lt;/CLASSPATH&gt;
	&lt;IMPORTS&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.*&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPModelElement&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPTableView&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.*&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPApplication&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.List&lt;/IMPORT&gt;
	&lt;/IMPORTS&gt;
	&lt;USER-DEFINED-METHOD isUserDefinedMethod=&quot;FALSE&quot;&gt;&lt;/USER-DEFINED-METHOD&gt;
	&lt;ALLOW-SELECTOR&gt;FALSE&lt;/ALLOW-SELECTOR&gt;
	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;List of model elements&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;ArrayList&amp;lt;IRPModelElement&amp;gt; StereotypeList = new ArrayList&amp;lt;IRPModelElement&amp;gt;();

IRPFlow myflow = (IRPFlow) cellElement;

IRPSysMLPort mysysmlport = myflow.getEnd1SysMLPort();

if(mysysmlport instanceof IRPSysMLPort){
	
	for(Object o : mysysmlport.getStereotypes().toList()){
		if(o instanceof IRPStereotype){
			IRPStereotype currentIRPStereotype = (IRPStereotype) o;

			if( currentIRPStereotype.getIsNewTerm() == 0 &amp;amp;&amp;amp; currentIRPStereotype != null ){
				StereotypeList.add(currentIRPStereotype);
			}
		}
	}
	
	return StereotypeList;
}
else
{
	return null;
}&lt;/CODE&gt;
	&lt;/GETTER&gt;
	&lt;SETTER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/SETTER&gt;
