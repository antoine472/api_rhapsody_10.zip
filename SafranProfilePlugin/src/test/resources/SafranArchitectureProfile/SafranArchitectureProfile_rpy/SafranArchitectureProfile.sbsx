			IRPSysMLPort currentToPort = currentIRPLink.getToSysMLPort();
			String directionTo = currentToPort.getPortDirection();
			String directionFrom = currentIRPSysMLPort.getPortDirection();
			
			if (directionTo.equals(&amp;quot;InOut&amp;quot;) || directionFrom.equals(&amp;quot;InOut&amp;quot;))
