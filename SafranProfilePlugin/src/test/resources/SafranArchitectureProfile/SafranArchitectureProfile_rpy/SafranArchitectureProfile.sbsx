if(cellElement instanceof IRPUseCase){
	IRPUseCase currentIRPUseCase = (IRPUseCase) cellElement;
	for(Object o : currentIRPUseCase.getReferences().toList()){
		if(o instanceof IRPDependency){
			IRPDependency currentIRPDependency = (IRPDependency) o;
			IRPModelElement sourceIRPDependency = currentIRPDependency.getDependent();
			if(sourceIRPDependency instanceof IRPClass){
				IRPClass currentIRPClass = (IRPClass)sourceIRPDependency; 
				IRPStereotype currentIRPStereotype = currentIRPClass.getNewTermStereotype();
				if (currentIRPStereotype != null) {
					if ((currentIRPStereotype.getName()).compareTo(&amp;quot;Function_&amp;quot;)==0){
						FunctionList.add(currentIRPClass);
					}
				}
			}
		}
	}
	return FunctionList;
}
else{
return null;
}&lt;/CODE&gt;
