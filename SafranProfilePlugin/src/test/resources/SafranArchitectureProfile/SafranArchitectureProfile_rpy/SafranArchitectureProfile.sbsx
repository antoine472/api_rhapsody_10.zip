&lt;IMPLEMENTATION&gt;
	&lt;CLASSPATH&gt;
	&lt;/CLASSPATH&gt;
	&lt;IMPORTS&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.*&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPModelElement&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPTableView&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.*&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPApplication&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.List&lt;/IMPORT&gt;
	&lt;/IMPORTS&gt;
	&lt;USER-DEFINED-METHOD isUserDefinedMethod=&quot;FALSE&quot;&gt;Implementation...&lt;/USER-DEFINED-METHOD&gt;
	&lt;ALLOW-SELECTOR&gt;FALSE&lt;/ALLOW-SELECTOR&gt;
	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;String&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;IRPSysMLPort fromSysmlPort = null;

String currentPortDirection = &amp;quot;&amp;quot;;

if( cellElement instanceof IRPLink ){
	
	//IRPSysMLPort currentIRPSysMLPort = ( IRPSysMLPort ) cellElement;
	IRPLink  currentIRPLink = ( IRPLink ) cellElement;
	
	IRPStereotype currentIRPStereotype = currentIRPLink.getNewTermStereotype();

	if (currentIRPStereotype != null) {
		if ((currentIRPStereotype.getName()).compareTo(&amp;quot;ContinuousLink&amp;quot;)==0){

			if( currentIRPLink.getFromSysMLPort() != null  ){
				fromSysmlPort  =  currentIRPLink.getFromSysMLPort();
			}
			else{
				fromSysmlPort  =  ( IRPSysMLPort ) currentIRPLink.getFromElement();
			}	
			currentPortDirection = fromSysmlPort.getPortDirection();
		}
	}

	return currentPortDirection ;
	
}else
{
	return null;
}&lt;/CODE&gt;
	&lt;/GETTER&gt;
	&lt;SETTER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/SETTER&gt;
	&lt;PICKER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/PICKER&gt;
&lt;/IMPLEMENTATION&gt;
&lt;/COLUMN&gt;
&lt;COLUMN id=&quot;5&quot;&gt;
&lt;IMPLEMENTATION&gt;
	&lt;CLASSPATH&gt;
	&lt;/CLASSPATH&gt;
	&lt;IMPORTS&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.*&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPModelElement&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPTableView&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.*&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPApplication&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.List&lt;/IMPORT&gt;
	&lt;/IMPORTS&gt;
	&lt;USER-DEFINED-METHOD isUserDefinedMethod=&quot;FALSE&quot;&gt;Implementation...&lt;/USER-DEFINED-METHOD&gt;
	&lt;ALLOW-SELECTOR&gt;FALSE&lt;/ALLOW-SELECTOR&gt;
	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;List of model elements&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;ArrayList&amp;lt;IRPModelElement&amp;gt; StereotypeList = new ArrayList&amp;lt;IRPModelElement&amp;gt;();
IRPSysMLPort fromSysmlPort = null;
IRPPort fromPort  =  null;

if( cellElement instanceof IRPLink ){
	
	//IRPSysMLPort currentIRPSysMLPort = ( IRPSysMLPort ) cellElement;
	IRPLink  currentIRPLink = ( IRPLink ) cellElement;
	
	IRPStereotype currentIRPStereotype = currentIRPLink.getNewTermStereotype();

	if (currentIRPStereotype != null) {
		if ((currentIRPStereotype.getName()).compareTo(&amp;quot;ContinuousLink&amp;quot;)==0){

			if( currentIRPLink.getFromSysMLPort() != null  ){
				fromSysmlPort  =  currentIRPLink.getFromSysMLPort();
			}
			else{
				fromSysmlPort  =  ( IRPSysMLPort ) currentIRPLink.getFromElement();
			}	
	
			for(Object o : fromSysmlPort.getStereotypes().toList()){
				if(o instanceof IRPStereotype){
					IRPStereotype currentIRPStereotype2 = (IRPStereotype) o;

					if( currentIRPStereotype2.getIsNewTerm() == 0 &amp;amp;&amp;amp; currentIRPStereotype != null ){
						StereotypeList.add(currentIRPStereotype2);
					}
				}
			}
		}
		if ((currentIRPStereotype.getName()).compareTo(&amp;quot;DiscreteLink&amp;quot;)==0){

			if( currentIRPLink.getFromPort() != null  ){
				fromPort  =  currentIRPLink.getFromPort();
			}
			else{
				fromPort  =  ( IRPPort ) currentIRPLink.getFromElement();
			}	
	
			for(Object o : fromPort.getStereotypes().toList()){
				if(o instanceof IRPStereotype){
					IRPStereotype currentIRPStereotype2 = (IRPStereotype) o;

					if( currentIRPStereotype2.getIsNewTerm() == 0 &amp;amp;&amp;amp; currentIRPStereotype != null ){
						StereotypeList.add(currentIRPStereotype2);
					}
				}
			}
		}
	}

	return StereotypeList;
	
}else
{
	return null;
}&lt;/CODE&gt;
	&lt;/GETTER&gt;
	&lt;SETTER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/SETTER&gt;
	&lt;PICKER&gt;
